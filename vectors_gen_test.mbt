///|
test "vector: standard-detects-pii" {
  let input = "demo@example.com 10.0.0.1 4111111111111111"
  let findings = @moon_scrub.scan(input)
  assert_eq(findings.length(), 3)
  assert_eq(findings[0].kind.to_string(), "EMAIL")
  assert_eq(findings[0].start, 0)
  assert_eq(findings[0].end, 16)
  assert_eq(findings[0].confidence, @moon_scrub.High)
  assert_eq(
    input[findings[0].start:findings[0].end].to_owned(),
    "demo@example.com",
  )
  assert_eq(findings[1].kind.to_string(), "IPV4")
  assert_eq(findings[1].start, 17)
  assert_eq(findings[1].end, 25)
  assert_eq(findings[1].confidence, @moon_scrub.Medium)
  assert_eq(input[findings[1].start:findings[1].end].to_owned(), "10.0.0.1")
  assert_eq(findings[2].kind.to_string(), "PAYMENT_CARD")
  assert_eq(findings[2].start, 26)
  assert_eq(findings[2].end, 42)
  assert_eq(findings[2].confidence, @moon_scrub.High)
  assert_eq(
    input[findings[2].start:findings[2].end].to_owned(),
    "4111111111111111",
  )
}

